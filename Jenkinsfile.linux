pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'python3 -m venv venv'
                sh './venv/bin/pip install -r requirements.txt'
            }
        }
        stage('Test') {
            steps {
                sh './venv/bin/python -m unittest discover -v'
            }
        }
        stage('Deploy') {
            steps {
                sh 'mkdir -p deployment && cp app.py deployment/'
                sh 'echo "Deployed:" && ls -l deployment/'
            }
        }
    }
    post {
        success { echo 'Pipeline succeeded - app deployed.' }
        failure { echo 'Pipeline failed - check the logs.' }
    }
}
